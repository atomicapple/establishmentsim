; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Establishment Simulator"
config/description="An establishment management simulation built with Godot 4 and C#."
config/version="0.1.0"
run/main_scene="res://test_scene.tscn"
config/features=PackedStringArray("4.7", "C#")

[autoload]

GameStateManager="*res://GameStateManager.cs"
StaffRoster="*res://StaffRoster.cs"
CharacterSpawner="*res://CharacterSpawner.cs"

[dotnet]

project/assembly_name="EstablishmentSimulator"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")
